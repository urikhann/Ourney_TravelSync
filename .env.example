# Template only; never put real credentials in Git.
# DB commands load .env from the current directory; exported variables take precedence.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelsync
DB_USER=travelsync
DB_PASSWORD=
DB_SSLMODE=prefer
# Alternative: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Collector reads exported variables (or Colab Secrets), not this file automatically.
# TOUR_API_KEY=
# KAKAO_REST_API_KEY=
# Opt-in integration tests ONLY: TRAVELSYNC_TEST_DATABASE_URL=<disposable database URL>
