# Template only; never put real credentials in Git.
# Copy to .env in the repository root. .env is ignored by Git.

# ---------------------------------------------------------------------------
# Data + recommender tools (ourney-travelsync CLI, PostgreSQL scripts)
# DB commands load .env from the current directory; exported variables take precedence.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelsync
DB_USER=travelsync
DB_PASSWORD=
DB_SSLMODE=prefer
# Alternative: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Collector reads exported variables (or Colab Secrets), not this file automatically.
# TOUR_API_KEY=
# KAKAO_REST_API_KEY=
# Opt-in integration tests ONLY: TRAVELSYNC_TEST_DATABASE_URL=<disposable database URL>

# ---------------------------------------------------------------------------
# Web app + backend (api/, used by docker compose)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_USER=travelsync
POSTGRES_PASSWORD=travelsync
POSTGRES_DB=travelsync

# Where the backend finds each service (Docker service names).
# Running locally without Docker: the real recommender is services/recommender on http://localhost:8002
# (set RECOMMENDER_URL in api/.env); the mock stand-ins are services/mocks on port 8001.
RECOMMENDER_URL=http://recommender:8002
OPTIMIZER_URL=http://optimizer:8003
# Trusted service exposing POST /snapshot (planning-data-1.0).
# This must provide evidenced operating facts and actual directed routes, not place-search results.
PLANNING_DATA_URL=http://planning-data:8004
PLANNING_DATA_TOKEN=
PLANNING_DATA_TIMEOUT_SECONDS=180
# Run .\configure_kakao_key.ps1 to store a replacement REST key locally.
KAKAO_REST_API_KEY=
KAKAO_ROUTE_RADIUS=5000
KAKAO_ROUTE_CONCURRENCY=8
OPTIMIZER_TIMEOUT_SECONDS=45
AVAILABILITY_URL=http://mocks:8001
AGENT_URL=http://mocks:8001
# Real agent: services/agent on port 8005 (Docker sets AGENT_URL=http://agent:8005; locally use http://localhost:8005).
# Free key: https://aistudio.google.com/apikey  - never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opt-in provider trial: gemini (default), groq, or rules.
AGENT_PROVIDER=gemini
GROQ_API_KEY=
# Alternative: qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b

# Availability endpoints and holiday display; optimizer hours policy is separate.
FEATURE_AVAILABILITY=false

# Email (leave empty in development: codes are printed in the api log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TravelSync <no-reply@travelsync.app>

# One hash-validated deployment snapshot shared by API/recommender.
# Compose resolves these filenames inside /data. Local API uses the packaged paths by default.
PLACES_FILE=travelsync_poi_metadata_enriched_v4.csv
PLACES_VERSION=busan-enriched-v4-20261121
# TRAVELSYNC_DATASET_SNAPSHOT=src/ourney_travelsync/data/deployment_snapshot.json
# PLACES_CSV=src/ourney_travelsync/data/travelsync_poi_metadata_enriched_v4.csv
# Explicit initialization/activation: docs/deployment_snapshot.md. Restarts never activate.
# Group recommender sizes: each member's top list L and the group list K
REC_TOP_L=100
REC_GROUP_K=30

# E5 shared POI cache (no user preferences); model initialization is offline on requests.
# Prewarm before serving; see docs/e5_hybrid.md. Optional feature-only requests need no model.
TRAVELSYNC_E5_CACHE=output/e5-cache
TRAVELSYNC_E5_MODEL_CACHE=output/e5-models
TRAVELSYNC_HYBRID_ALPHA=0.5
TRAVELSYNC_SEMANTIC_BETA=1.0
TRAVELSYNC_E5_REGENERATE=0
