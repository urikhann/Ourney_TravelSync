# Template only; never put real credentials in Git.
# Copy to .env in the repository root. .env is ignored by Git.

# ---------------------------------------------------------------------------
# Data + recommender tools (ourney-travelsync CLI, PostgreSQL scripts)
# DB commands load .env from the current directory; exported variables take precedence.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelsync
DB_USER=travelsync
DB_PASSWORD=
DB_SSLMODE=prefer
# Alternative: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Collector reads exported variables (or Colab Secrets), not this file automatically.
# TOUR_API_KEY=
# KAKAO_REST_API_KEY=
# Opt-in integration tests ONLY: TRAVELSYNC_TEST_DATABASE_URL=<disposable database URL>

# ---------------------------------------------------------------------------
# Web app + backend (api/, used by docker compose)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_USER=travelsync
POSTGRES_PASSWORD=travelsync
POSTGRES_DB=travelsync

# Where the backend finds each service (Docker service names).
# Running locally without Docker: the real recommender is services/recommender on http://localhost:8002
# (set RECOMMENDER_URL in api/.env); the mock stand-ins are services/mocks on port 8001.
RECOMMENDER_URL=http://mocks:8001
OPTIMIZER_URL=http://mocks:8001
AVAILABILITY_URL=http://mocks:8001
AGENT_URL=http://mocks:8001

# Optional parts. The availability checker is postponed for the first version.
FEATURE_AVAILABILITY=false

# Email (leave empty in development: codes are printed in the api log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TravelSync <no-reply@travelsync.app>

# Place data: default is the enriched POI snapshot in the recommender package
# (src/ourney_travelsync/data/travelsync_poi_metadata_enriched_v1.csv). Empty = 28 sample places.
# PLACES_CSV=
# Group recommender sizes (SDD 8.3): each member's top list L and the group list K
REC_TOP_L=100
REC_GROUP_K=30
