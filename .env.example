# Copy to .env (same folder as docker-compose.yml). Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_USER=travelsync
POSTGRES_PASSWORD=travelsync
POSTGRES_DB=travelsync

# Where the backend finds each teammate's service.
# Default: the mock service in this repo. Point a URL at the real service when it's ready.
RECOMMENDER_URL=http://mocks:8001
OPTIMIZER_URL=http://mocks:8001
AVAILABILITY_URL=http://mocks:8001
AGENT_URL=http://mocks:8001

# Optional parts. The availability checker is postponed for the first version.
FEATURE_AVAILABILITY=false

# Email (leave empty in development: codes are printed in the api container log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TravelSync <no-reply@travelsync.app>

# Place data (data pipeline CSV). Empty = use the 28 sample places.
# PLACES_CSV=../data/places/travelsync_final_places.csv
# Group recommender sizes (SDD 8.3): each member's top list L and the group list K
REC_TOP_L=100
REC_GROUP_K=30
