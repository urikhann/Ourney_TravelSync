# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Source code and notebooks belong in Git.
/src/
/backend/
/frontend/
/recommender/
*.py
*.ipynb

# Project configuration, documentation, and dependency manifests belong in Git.
/.python-version
/pyproject.toml
/requirements*.txt
/uv.lock
/setup.py
/setup.cfg
/README*
/docs/
/tests/
/.gitignore
/.gitattributes
/.github/
/AGENTS.md
/dvc.yaml
/dvc.lock

# Local environments, caches, secrets, and experiment outputs.
.venv/
.vscode/
__pycache__/
*.pyc
.env
.env.*
/dvclive/
/mlflow.db
/mlflow.db-*
/mlartifacts/
/mlruns/
